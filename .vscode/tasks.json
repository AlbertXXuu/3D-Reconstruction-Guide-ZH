    {"label": "Demo: VGGT", "type": "process", "command": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/start-demo.ps1", "-Model", "vggt"], "problemMatcher": []},
